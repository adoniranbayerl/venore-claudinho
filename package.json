{
  "name": "venore-docks-1.0.0",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:generate:academy": "drizzle-kit generate --config=src/plugins/academy/drizzle.config.ts",
    "db:migrate:academy": "drizzle-kit migrate --config=src/plugins/academy/drizzle.config.ts",
    "db:generate:birthdays": "drizzle-kit generate --config=src/plugins/birthdays/drizzle.config.ts",
    "db:migrate:birthdays": "drizzle-kit migrate --config=src/plugins/birthdays/drizzle.config.ts",
    "db:seed:admin-access": "node --env-file=.env scripts/seed-admin-access-permission.mjs",
    "db:seed:media-manage": "node --env-file=.env scripts/seed-media-manage-permission.mjs",
    "db:seed:cms-menus-manage": "node --env-file=.env scripts/seed-cms-menus-permission.mjs",
    "db:seed:observability-logs-view": "node --env-file=.env scripts/seed-observability-logs-permission.mjs",
    "db:seed:observability-logs-clear": "node --env-file=.env scripts/seed-observability-logs-clear-permission.mjs",
    "db:seed:observability-audit-view": "node --env-file=.env scripts/seed-observability-audit-view-permission.mjs",
    "db:bootstrap-superadmin": "tsx --env-file=.env scripts/bootstrap-superadmin.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@radix-ui/react-avatar": "^1.2.6",
