    "@radix-ui/react-tabs": "^1.1.21",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/static-renderer": "^3.29.2",
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
