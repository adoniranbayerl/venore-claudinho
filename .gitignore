# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# media (driver local de contexts/media, dev)
/public/uploads/

# broadcast plugin — vídeos são específicos de cada deploy/servidor, nunca devem ir pro Git
# (arquivos grandes). .gitkeep preserva a pasta vazia num clone novo.
/public/broadcast/videos/*
!/public/broadcast/videos/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts
